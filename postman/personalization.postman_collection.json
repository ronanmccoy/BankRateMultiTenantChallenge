{
  "info": {
    "name": "Personalization Service (multi-tenant prototype)",
    "description": "Example requests for POST /v1/personalize. Start the server with `npm run dev` first. Simulate outages with `FAKE_PRICING=error npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Tenant 0 member: savings rate + members-only rewards card",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/personalize",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "personalize"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": \"tenant0\",\n  \"surface\": \"offers\",\n  \"user\": { \"id\": \"member-1\", \"claims\": {} }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Switchback user, eligible: baseline savings + Switchback Partner Rate",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
