          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/personalize",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "personalize"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": \"switchback\",\n  \"surface\": \"offers\",\n  \"user\": {\n    \"id\": \"worker-1\",\n    \"claims\": { \"sb_tenure_months\": 8, \"sb_monthly_earnings_usd\": 4100 }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Switchback user, not eligible (tenure too short): baseline savings only",
