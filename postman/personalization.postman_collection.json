        ],
        "url": {
          "raw": "{{baseUrl}}/v1/personalize",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "personalize"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant\": \"switchback\",\n  \"surface\": \"offers\",\n  \"user\": {\n    \"id\": \"worker-2\",\n    \"claims\": { \"sb_tenure_months\": 3, \"sb_monthly_earnings_usd\": 4100 }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "The decision record in the server log explains why: \"tenureMonths >= 6: fail\""
      }
    },
